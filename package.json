    "test:new-cortex:registration:ui": "node skills/run.js new-cortex registration --ui",
    "test:new-cortex:reg-create": "node skills/run.js new-cortex reg-create",
    "test:new-cortex:reg-create:headed": "node skills/run.js new-cortex reg-create --headed",
    "test:new-cortex:reg-search": "node skills/run.js new-cortex reg-search",
    "test:new-cortex:reg-search:headed": "node skills/run.js new-cortex reg-search --headed",
    "test:new-cortex:advance-visits": "node skills/run.js new-cortex advance-visits",
