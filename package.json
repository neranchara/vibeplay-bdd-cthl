    "test:new-cortex:claim:2083": "node skills/run.js new-cortex claim ctxn-2083",
    "test:new-cortex:claim:2083:headed": "node skills/run.js new-cortex claim ctxn-2083 --headed",
    "test:new-cortex:claim:2111": "node skills/run.js new-cortex claim ctxn-2111",
